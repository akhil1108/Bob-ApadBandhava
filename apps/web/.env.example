# ──────────────────────────────────────────────────────────────
# LIFEBridge — environment variables template
# Copy to .env.local and fill in the values.
# NEVER commit .env.local or any real credentials.
# ──────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=LIFEBridge
NEXT_PUBLIC_APP_ENV=development

# ── Database (Supabase / PostgreSQL) ─────────────────────────
# Get this from: supabase.com → your project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── NextAuth ─────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── IBM watsonx.ai ───────────────────────────────────────────
# Get credentials from: cloud.ibm.com → watsonx.ai → your project
# Used ONLY server-side for the Incident Intake Agent.
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Supabase (optional — for direct Supabase client use) ─────
# Not required if you use Prisma + DATABASE_URL above.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
