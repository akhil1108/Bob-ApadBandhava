generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  passwordHash      String
  role              Role
  phone             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  ambulanceProfile  AmbulanceProfile?
  doctorProfile     DoctorProfile?
  hospitalProfile   HospitalProfile?
  reportedIncidents Incident[]        @relation("Reporter")
  patientProfile    PatientProfile?
  volunteerProfile  VolunteerProfile?
}

model PatientProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  dob           DateTime?
  bloodGroup    String?
  allergies     String?
  createdAt     DateTime       @default(now())
  consents      Consent[]
  consultations Consultation[]
  user          User           @relation(fields: [userId], references: [id])
}

model DoctorProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  specialisation String?
  licenceNumber  String?
  createdAt      DateTime       @default(now())
  consultations  Consultation[]
  user           User           @relation(fields: [userId], references: [id])
}

model Consultation {
  id           String         @id @default(cuid())
  patientId    String
  doctorId     String
  notes        String?
  prescription String?
  aiSummary    String?
  consultedAt  DateTime       @default(now())
  doctor       DoctorProfile  @relation(fields: [doctorId], references: [id])
  patient      PatientProfile @relation(fields: [patientId], references: [id])
  documents    Document[]
}

model Document {
  id             String       @id @default(cuid())
  consultationId String
  fileName       String
  fileUrl        String
  uploadedAt     DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model Consent {
  id          String         @id @default(cuid())
  patientId   String
  requestedBy String
  purpose     String
  status      ConsentStatus  @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  patient     PatientProfile @relation(fields: [patientId], references: [id])
}

model HospitalProfile {
  id        String             @id @default(cuid())
  userId    String             @unique
  address   String?
  latitude  Float?
  longitude Float?
  capacity  Int?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id])
  incidents IncidentResponse[] @relation("HospitalResponses")
}

model AmbulanceProfile {
  id        String             @id @default(cuid())
  userId    String             @unique
  vehicleNo String?
  latitude  Float?
  longitude Float?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id])
  incidents IncidentResponse[] @relation("AmbulanceResponses")
}

model Incident {
  id          String             @id @default(cuid())
  reporterId  String
  description String
  latitude    Float
  longitude   Float
  status      IncidentStatus     @default(REPORTED)
  aiExtracted Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  heroActions HeroAction[]
  reporter    User               @relation("Reporter", fields: [reporterId], references: [id])
  responses   IncidentResponse[]
}

model IncidentResponse {
  id           String            @id @default(cuid())
  incidentId   String
  hospitalId   String?
  ambulanceId  String?
  acknowledged Boolean           @default(false)
  respondedAt  DateTime?
  createdAt    DateTime          @default(now())
  ambulance    AmbulanceProfile? @relation("AmbulanceResponses", fields: [ambulanceId], references: [id])
  hospital     HospitalProfile?  @relation("HospitalResponses", fields: [hospitalId], references: [id])
  incident     Incident          @relation(fields: [incidentId], references: [id])
}

model VolunteerProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  certified   Boolean      @default(false)
  points      Int          @default(0)
  createdAt   DateTime     @default(now())
  heroActions HeroAction[]
  user        User         @relation(fields: [userId], references: [id])
}

model HeroAction {
  id            String           @id @default(cuid())
  incidentId    String
  volunteerId   String
  description   String?
  verified      Boolean          @default(false)
  pointsAwarded Int              @default(0)
  createdAt     DateTime         @default(now())
  incident      Incident         @relation(fields: [incidentId], references: [id])
  volunteer     VolunteerProfile @relation(fields: [volunteerId], references: [id])
}

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL
  AMBULANCE
  VOLUNTEER
  ADMIN
}

enum IncidentStatus {
  REPORTED
  ACKNOWLEDGED
  DISPATCHED
  ARRIVED
  COMPLETED
  CANCELLED
}

enum ConsentStatus {
  PENDING
  APPROVED
  REVOKED
}
